{
  "name": "cvss-guru-assets",
  "private": true,
  "description": "Build tooling for CVSS Guru front-end assets (compiled Tailwind CSS, self-hosted fonts and libraries).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/tailwind.css -o app/static/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/tailwind.css -o app/static/css/app.css --watch",
    "vendor": "node scripts/vendor_assets.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@highlightjs/cdn-assets": "11.9.0",
    "@phosphor-icons/web": "2.1.1",
    "htmx.org": "1.9.10",
    "swagger-ui-dist": "5.9.0",
    "tailwindcss": "3.4.17"
  }
}
