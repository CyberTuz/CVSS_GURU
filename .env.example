# CVSS Guru configuration. Copy to .env and fill in what you need.

# ── Mode ─────────────────────────────────────────────────────────────────────
# true = run it just for yourself: no database, no accounts, no API keys or
# quotas, no CAPTCHA. Everything below except OpenRouter can then stay empty.
# Never enable it on a public server.
LOCAL_MODE=false

# Canonical address. www.cvss.guru, cvss.help and cvss.info redirect here (app/config.py).
SITE_URL=https://cvss.guru

# ── Database and sessions (not needed in local mode) ─────────────────────────
# Dedicated PostgreSQL database with the citext extension (see README).
DATABASE_URL=postgresql://cvss_guru:<password>@<host>:5432/cvss_guru?sslmode=require
# Connections per worker process (gunicorn runs 4 workers)
# DB_POOL_SIZE=4
# Seconds to wait for a free connection before failing
# DB_POOL_TIMEOUT=5

# Signs session cookies and CSRF tokens. Required in production: openssl rand -hex 32
JWT_SECRET=
# Secure cookie flag, auto-detected from SITE_URL (https → true). Override only if needed.
# SECURE_COOKIES=true

# ── Account emails: verification, password reset, account deletion ───────────
SMTP_HOST=
# 465 = implicit TLS. Other ports: SMTP_USE_TLS=true → STARTTLS (587), false → plain.
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Plain address or "CVSS Guru <info@cvss.guru>"
SMTP_FROM=info@cvss.guru

# ── Google reCAPTCHA v3 ──────────────────────────────────────────────────────
# Protects the AI Scorer and the sign-in, sign-up and password reset forms.
# Create a v3 key at https://www.google.com/recaptcha/admin for cvss.guru (+ localhost).
# Without keys the AI Scorer refuses requests; the account forms skip the check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score to accept (0.0 = bot, 1.0 = human)
RECAPTCHA_MIN_SCORE=0.5

# ── AI Scorer (OpenRouter) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Benchmarked options (scripts/ai_benchmark/README.md):
#   openai/gpt-6-luna                       default: reliable, ~5 s, ~$0.35 per 1000 analyses
#   z-ai/glm-5.3-flash + effort=low         faster (~3 s) and cheaper, same accuracy
#   nvidia/nemotron-3-super-120b-a12b:free  free, ~13 s, free-tier rate limits (fine for local mode)
OPENROUTER_MODEL=openai/gpt-6-luna
# Reasoning effort for "thinking" models (minimal|low|medium|high); "low" for GLM and Nemotron
OPENROUTER_REASONING_EFFORT=
# Seconds before an AI request is abandoned
OPENROUTER_TIMEOUT=60

# ── CVE Search ───────────────────────────────────────────────────────────────
# Optional: raises the NVD rate limit from 5 to 50 requests per 30 s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── RapidAPI (optional) ──────────────────────────────────────────────────────
# Proxy secret from RapidAPI (Gateway → Firewall settings): requests carrying it skip
# the local API-key check and monthly quota, since RapidAPI handles both.
RAPIDAPI_PROXY_SECRET=
# Public listing, linked when a free API key reaches its monthly quota
RAPIDAPI_URL=

# ── Analytics and privacy ────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX); cookies only after consent.
GA_MEASUREMENT_ID=
# Data controller and contact shown on /privacy
PRIVACY_CONTROLLER=CVSS Guru
CONTACT_EMAIL=info@cvss.guru

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
